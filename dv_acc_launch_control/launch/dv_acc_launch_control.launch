<launch>
  <!-- Path to JSON config. Defaults to package config/params.json -->
  <arg name="config_path" default="$(find dv_acc_launch_control)/config/params.json" />

  <!-- Print config summary on startup -->
  <arg name="print_config" default="false" />

  <node pkg="dv_acc_launch_control"
        type="dv_acc_launch_control_node"
        name="acc_launch_controller"
        output="screen">
    <param name="config_path" value="$(arg config_path)" />
    <param name="print_config" value="$(arg print_config)" />
  </node>
</launch>
