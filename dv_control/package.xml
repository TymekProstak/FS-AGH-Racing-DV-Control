<?xml version="1.0"?>
<package format="2">
  <name>dv_control</name>
  <version>1.0.0</version>
  <description>Trackdrive and autocross controller with BF speed profile, unbounded LTV MPC and four-wheel torque allocation.</description>

  <maintainer email="timiprostak@gmail.com">Tymek Prostak</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>dv_interfaces</depend>
  <depend>eigen</depend>
  <depend>nlohmann_json</depend>
</package>
